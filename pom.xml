		Public Repository</name> <url>https://maven.scijava.org/content/groups/public/</url> 
		</repository> <repository> <id>mvn-repo-master</id> <url>https://raw.github.com/nroduit/mvn-repo/master/</url> 
		<snapshots> <enabled>false</enabled> </snapshots> </repository> </repositories> -->

</project>
